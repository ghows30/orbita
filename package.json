{
  "name": "orbita",
  "version": "1.0.0",
  "private": true,
  "description": "ORBITA – player IPTV (M3U / Xtream) con proxy locale sicuro",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.mjs --dev\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "serve": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs",
    "test": "vitest run",
    "build:android-web": "vite build --outDir android/app/src/main/assets/web --emptyOutDir",
    "apk": "npm run build:android-web && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "hls.js": "1.5.20",
    "mpegts.js": "1.8.0"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "3.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
